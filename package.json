{
  "name": "codex-remotion-video",
  "version": "1.0.0",
  "private": true,
  "description": "此刻 · 综合新闻聚合网站",
  "scripts": {
    "dev": "node server.mjs",
    "render": "remotion render src/creator-entry.tsx CreatorVideo out/motion-video.mp4",
    "typecheck": "tsc --noEmit",
    "studio": "remotion studio src/creator-entry.tsx --port=3001",
    "build": "vite build",
    "test": "node --test tests/news.test.mjs && node tests/run-news-ui.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.533",
    "@remotion/cli": "4.0.533",
    "@remotion/google-fonts": "4.0.533",
    "@remotion/player": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "@remotion/transitions": "4.0.533",
    "fast-xml-parser": "5.11.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.533",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3"
  }
}
