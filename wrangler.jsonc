{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "current-news-api",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://aaronxdd.github.io"
  }
}
